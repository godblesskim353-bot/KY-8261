# Copy to /etc/polymarket-bot/polymarket-bot.env and chmod 600.
# Never commit the copied file or paste secret values into GitHub.

PORT=8080
NODE_ENV=production
LIVE_TRADING_ENABLED=false
POLYMARKET_EXECUTION_PYTHON=/opt/polymarket-bot/.venv/bin/python
POLYMARKET_BALANCE_PYTHON=/opt/polymarket-bot/.venv/bin/python
POLYMARKET_SINGLE_EXECUTION_JOURNAL_PATH=/var/lib/polymarket-bot/execution-journal.json

# Required market configuration.
POLYMARKET_CONDITION_ID=
POLYMARKET_YES_TOKEN_ID=
POLYMARKET_NO_TOKEN_ID=

# Required for live CLOB reads/orders.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
RESIDENTIAL_PROXY_URL=

# Optional.
POLYMARKET_SIGNATURE_TYPE=
LOG_LEVEL=info